name: Isolated sbt repair Linux validation

on:
  push:
    branches:
      - codex/guided-fixed-budget
    paths:
      - .github/workflows/sbt-repair-linux.yml
      - tools/sbt-worker-repair/**
      - tools/validation_support.py
      - tools/test_ci_repair.py
  workflow_dispatch:

permissions:
  contents: read

defaults:
  run:
    shell: bash

jobs:
  isolated-sbt-repair:
    if: github.ref == 'refs/heads/codex/guided-fixed-budget'
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '17'
      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'
      - name: Check validation tooling and reference mappings
        run: |
          python -B tools/test_ci_repair.py
          python -B tools/docs/check_research_references.py
      - name: Run isolated two-pass branch pilot and failure controls
        run: python -B tools/sbt-worker-repair/branch_pilot.py --output "$RUNNER_TEMP/sbt-ci-pilot"
      - name: Retain complete bounded validation evidence
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: isolated-sbt-pilot-evidence
          if-no-files-found: error
          path: ${{ runner.temp }}/sbt-ci-pilot/evidence/
